              "op": "add",
              "text": "only, not during server rendering.",
              "kind": "prose"
            },
            {
              "op": "add",
              "text": "",
              "kind": "prose"
            },
            {
              "op": "context",
              "text": "By default, CopilotKit includes the catalog schema in agent context. Set",
